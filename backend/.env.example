# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
# Where the Next.js frontend runs (CORS + redirects after Google sign-in)
FRONTEND_URL=http://localhost:3000
# Public URL of this API, used to build photo URLs and the Google callback
API_URL=http://localhost:8000

# ─── Database: Supabase ───────────────────────────────────────────────────────
# Supabase dashboard → Project → Connect → ORMs → Prisma.
# DATABASE_URL: transaction pooler (port 6543) — used by the running app.
# DIRECT_URL:   direct connection (port 5432) — used by `prisma migrate`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Only needed for `prisma migrate dev` against a local database
# SHADOW_DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_GUEST_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
GUEST_TOKEN_TTL_DAYS=30

# Google sign-in (optional). Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@eventwall.com
ADMIN_PASSWORD=change-me-please

# ─── Storage ──────────────────────────────────────────────────────────────────
# local = files in UPLOAD_DIR, served at {API_URL}/uploads. S3 driver comes later.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Extra frontend origins allowed by CORS, comma-separated (FRONTEND_URL is always allowed)
CORS_ORIGINS=
