# Backend API base URL. Leave unset locally: the browser then uses the page host on port 8000
# (NEXT_PUBLIC_API_PORT), so a phone on the LAN works without knowing the IP.
# NEXT_PUBLIC_API_URL=
# On Vercel set it to the deployed API, e.g. NEXT_PUBLIC_API_URL=https://eventwall-api.onrender.com/api
# Optional: server-side URL of the API if it differs inside your network (Docker, etc.)
# API_URL_INTERNAL=
# Optional: slug of a demo event for the landing "See guest view" / "View live wall" buttons
NEXT_PUBLIC_DEMO_EVENT_SLUG=
